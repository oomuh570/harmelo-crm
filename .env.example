# This file is a template for environment variables. Copy this file to `.env.local` and fill in the values to configure your application. Do not commit `.env.local` to version control, as it may contain sensitive information.  
     

# Database — Supabase Postgres
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Session — generate with: openssl rand -base64 32
SESSION_SECRET=


# Base URL of the app (used for invitation links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Gmail SMTP for outbound email (invitations, follow-up reminders).
# GMAIL_PASSWORD is a Google App Password, not the account password.
# If left blank, invitation links are printed to the server console instead of emailed.
GMAIL_USER=
GMAIL_PASSWORD=
