/**
 * Harmelo CRM Database Schema
 *
 * Core models:
 * - User: Internal users who create and manage activities
 * - Contact: Organizations, government bodies, investors, partners, or customers
 * - Activity: Communication logs (calls, emails, meetings, notes) tied to contacts
 * - Tag: Labels to categorize and filter contacts
 * - ContactTag: Junction table for many-to-many relationships between contacts and tags
 *
 * Soft-Delete Pattern:
 * Models with deletedAt field use logical deletion (soft-delete).
 * Records are marked as deleted but not removed from the database.
 * All queries must filter WHERE deletedAt IS NULL to exclude deleted records.
 *
 * Indexes: Added on frequently filtered columns (type, deletedAt, contactId, etc.)
 * for better query performance.
 *
 * After schema changes, run: npx prisma migrate dev --name <description>
 */

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

/// User model representing internal Harmelo team members
/// Users create and manage activities associated with contacts
model User {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  password    String
  phoneNumber String?
  role        UserRole @default(MEMBER)

  // Gmail OAuth
  gmailConnected    Boolean?     @default(false)
  gmailRefreshToken String?      // Encrypted refresh token
  gmailLastSync     DateTime?    // When we last synced emails

  createdAt   DateTime @default(now())
  deletedAt   DateTime? /// Soft-delete marker for admin-removed members; historical activities are preserved.

  activities        Activity[]
  invitationsSent   UserInvitation[] @relation("InvitationsSent")

  @@index([role])
  @@index([deletedAt])
}

enum UserRole {
  ADMIN
  MEMBER
}

/// Pending or accepted invitations sent by an admin to onboard a new team member.
/// Signup requires a valid, unexpired, unaccepted token that matches the invited email.
model UserInvitation {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  role        UserRole  @default(MEMBER)
  invitedById String
  invitedBy   User      @relation("InvitationsSent", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([token])
}

/// Contact model representing institutional relationships
/// Stores details about governments, investors, partners, customers, or other entities
/// Uses soft-delete pattern: deletedAt marks deletion without removing data
model Contact {
  id           String       @id @default(cuid())
  name         String       /// Required; person or organization name
  email        String?      /// Optional; email address
  phone        String?      /// Optional; phone number with dashes (e.g., "403-330-2322")
  organization String?      /// Optional; organization name
  jobTitle     String?      /// Optional; job title or role
  type         ContactType  @default(OTHER) /// Category: FEDERAL, PROVINCIAL, US, INVESTOR, CUSTOMER, PARTNER, or OTHER
  address      String?      /// Optional; street address
  notes        String?      /// Optional; rich text HTML notes
  createdAt    DateTime     @default(now()) /// Auto-set to creation timestamp
  updatedAt    DateTime     @updatedAt      /// Auto-updated on any change
  deletedAt    DateTime?    /// Null for active; set to deletion timestamp for soft-deleted contacts
  activities   Activity[]   /// One-to-many: activities related to this contact
  tags         ContactTag[] /// Many-to-many: tags applied to this contact

  @@index([type])
  @@index([organization])
  @@index([deletedAt])  /// Important for filtering out soft-deleted records
}

enum ContactType {
  FEDERAL
  PROVINCIAL
  US
  INVESTOR
  CUSTOMER
  PARTNER
  OTHER
}

/// Activity model representing communications with contacts
/// Stores calls, emails, meetings, and notes; tracks follow-ups
/// Uses soft-delete pattern: deletedAt marks deletion without removing data
model Activity {
  id             String          @id @default(cuid())
  type           ActivityType    @default(NOTE)             /// Type: CALL, EMAIL, MEETING, or NOTE
  notes          String          /// Rich text HTML content of the activity
  occurredAt     DateTime        @default(now())            /// When the activity took place
  followUpAt     DateTime?       /// Optional; when to follow up on this activity
  followUpStatus FollowUpStatus? /// Status of follow-up: PENDING, COMPLETED, or CANCELLED
  createdAt      DateTime        @default(now())            /// Auto-set to creation timestamp
  updatedAt      DateTime        @updatedAt                 /// Auto-updated on any change
  deletedAt      DateTime?       /// Null for active; set for soft-deleted activities
  contact        Contact?        @relation(fields: [contactId], references: [id]) /// Optional; standalone activities have no contact
  contactId      String?         /// Nullable FK; null means the activity isn't tied to a specific contact
  user           User            @relation(fields: [userId], references: [id])   /// User who created this activity
  userId         String          /// Foreign key to User
  
  // Reminder tracking
  reminderSent    Boolean?  @default(false)  // Track if reminder email was sent
  
  // Gmail sync fields
  externalEmailId String?       @unique /// Gmail message ID for deduplication
  isAutoLogged    Boolean?      @default(false) /// true if auto-logged from Gmail
  
  @@index([contactId])
  @@index([userId])
  @@index([followUpAt])         /// For querying activities by follow-up date
  @@index([followUpStatus])     /// For filtering by follow-up status
  @@index([deletedAt])          /// Important for filtering out soft-deleted records
  @@index([externalEmailId])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Tag model representing labels to categorize and filter contacts
/// Uses soft-delete pattern: deletedAt marks deletion without removing data
model Tag {
  id        String       @id @default(cuid())
  name      String       /// Tag name (e.g., "VIP", "Lead", "Strategic")
  color     String       @default("#6b7280") /// Hex color for UI display
  createdAt DateTime     @default(now())    /// Auto-set to creation timestamp
  deletedAt DateTime?    /// Null for active; set for soft-deleted tags

  contacts  ContactTag[] /// Many-to-many: contacts with this tag

  /// Unique constraint: tag names must be unique among non-deleted tags
  /// Allows re-using names after soft-delete (via composite unique with deletedAt)
  @@unique([name, deletedAt])
  @@index([deletedAt])  /// Important for filtering out soft-deleted records
}

/// ContactTag junction table for many-to-many Contact <-> Tag relationships
/// A contact can have many tags; a tag can be applied to many contacts
model ContactTag {
  contact   Contact  @relation(fields: [contactId], references: [id]) /// Associated contact
  contactId String   /// Foreign key to Contact
  tag       Tag      @relation(fields: [tagId], references: [id])    /// Associated tag
  tagId     String   /// Foreign key to Tag
  createdAt DateTime @default(now())                                  /// When this tag was applied

  /// Composite primary key ensures each (contact, tag) pair appears only once
  @@id([contactId, tagId])
  @@index([contactId])  /// For finding all tags for a contact
  @@index([tagId])      /// For finding all contacts with a tag
}