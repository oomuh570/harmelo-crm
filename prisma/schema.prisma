// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"

}

datasource db {
  provider  = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phoneNumber String?
  password    String
  createdAt   DateTime @default(now())
  activities   Activity[]
}

// Contact represents a person or organization Harmelo tracks.
// Future: Contact will have a one-to-many relationship with Activity
// (one contact -> many logged interactions). Activity table added in a later task.

model Contact {
  id           String      @id @default(cuid())
  name         String
  email        String?
  phone        String?
  organization String?
  jobTitle     String?
  type         ContactType @default(OTHER)
  address      String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  activities   Activity[]


  @@index([type])
  @@index([organization])
  @@index([deletedAt])
}

enum ContactType {
  FEDERAL
  PROVINCIAL
  US
  INVESTOR
  CUSTOMER
  PARTNER
  OTHER
}


// Activity represents a logged interaction with a contact
// (call, email, meeting, or freeform note). An activity with
// a followUpAt set is what powers the follow-up reminders feature.
model Activity {
  id           String        @id @default(cuid())
  type         ActivityType  @default(NOTE)
  notes        String
  occurredAt   DateTime      @default(now())
  followUpAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  contact      Contact       @relation(fields: [contactId], references: [id])
  contactId    String

  user         User          @relation(fields: [userId], references: [id])
  userId       String

  @@index([contactId])
  @@index([userId])
  @@index([followUpAt])
  @@index([deletedAt])
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

